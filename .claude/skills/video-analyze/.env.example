# Copy to .env and fill in what you need. .env is git-ignored.
# Every key here is OPTIONAL — the pipeline degrades gracefully without them.

# Enables Whisper transcription. Without it, frames are still extracted and
# manifest.transcript is null.
OPENAI_API_KEY=

# Fallback downloader for Instagram / TikTok when browser cookies fail.
# Get one at https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# Which browser yt-dlp reads cookies from.
# chrome | firefox | safari | edge | brave | chromium | opera | vivaldi
VIDEO_ANALYZE_BROWSER=chrome

# Point transcription at an OpenAI-compatible endpoint (e.g. local whisper).
# OPENAI_BASE_URL=http://localhost:8000/v1
# WHISPER_MODEL=whisper-1
