 "lines": [
  {
   "id": "l01",
   "who": "defne",
   "scene": "bedroom",
   "start": 0.35,
   "dur": 3.101083,
   "text": "Bu kartın kime ait olduğunu öğrenmeden uyumayacağım."
  },
  {
   "id": "l02",
   "who": "defne",
   "scene": "bedroom",
   "start": 3.951,
   "dur": 4.777292,
   "text": "Bu kart benim adıma değil... Peki neden bu defterde benim hesaplarımla birlikte yazıyor?"
  },
  {
   "id": "l03",
   "who": "defne",
   "scene": "phone",
   "start": 9.928,
   "dur": 3.036292,
   "text": "Son dört hane: 4821. Bu kart benim adıma değil."
  },
  {
   "id": "l04",
   "who": "defne",
   "scene": "phone",
   "start": 13.465,
   "dur": 3.6445,
   "text": "Telefonu masaya bıraktım. Bu sessizliği bozmanın zamanı geldi."
  },
  {
   "id": "l05",
   "who": "ali",
   "scene": "door",
   "start": 20.909,
   "dur": 2.5915,
   "text": "Anne... Babam dün gece telefonda bir şey söyledi."
  },
  {
   "id": "l06",
   "who": "defne",
   "scene": "door",
   "start": 24.001,
   "dur": 3.994917,
   "text": "Başka bir hesaba para göndereceğini söylemiş. Bu çocuk bile bunu duymuş."
  },
  {
   "id": "l07",
   "who": "defne",
   "scene": "door",
   "start": 28.496,
   "dur": 2.177417,
   "text": "Ne söyledi bir tanem? Anlat bana, korkma."
  },
  {
   "id": "l08",
   "who": "defne",
   "scene": "kitchen",
   "start": 31.873,
   "dur": 4.055042,
   "text": "Kenan, sana bir şey soracağım. 4821 ile biten kredi kartı kimin?"
  },
  {
   "id": "l09",
   "who": "kenan",
   "scene": "kitchen",
   "start": 36.428,
   "dur": 2.034792,
   "text": "Ne kartı? Nereden çıkardın şimdi bunu?"
  },
  {
   "id": "l10",
   "who": "defne",
   "scene": "kitchen",
   "start": 38.963,
   "dur": 2.560792,
   "text": "Bir an duraksadı. Bu duraksama bana yeterdi."
  },
  {
   "id": "l11",
   "who": "kenan",
   "scene": "kitchen",
   "start": 42.024,
   "dur": 1.977625,
   "text": "Benim özel işlerimi neden araştırıyorsun?"
  },
  {
   "id": "l12",
   "who": "ali",
   "scene": "kitchen",
   "start": 44.501,
   "dur": 0.56975,
   "text": "Anne..."
  },
  {
   "id": "l13",
   "who": "defne",
   "scene": "salon",
   "start": 46.821,
   "dur": 4.527958,
   "text": "Çünkü bu defterde benim adıma yazılmış hesapların yanında aynı kart numarası var."
  },
  {
   "id": "l14",
   "who": "nermin",
   "scene": "salon",
   "start": 51.849,
   "dur": 2.473583,
   "text": "Bir dakika... Hangi defterden bahsediyorsunuz?"
  },
  {
   "id": "l15",
   "who": "defne",
   "scene": "salon",
   "start": 54.823,
   "dur": 2.372708,
   "text": "Defteri masanın üzerine koyuyorum. Okuyun."
  },
  {
   "id": "l16",
   "who": "defne",
   "scene": "salon",
   "start": 57.695,
   "dur": 3.420083,
   "text": "Masa sustu. Herkes o defterin içinde kendi adını arıyordu."
  },
  {
   "id": "l17",
   "who": "kenan",
   "scene": "salon",
   "start": 61.615,
   "dur": 1.757625,
   "text": "Anne, artık yeter. Bu konu kapandı!"
  },
  {
   "id": "l18",
   "who": "defne",
   "scene": "salon",
   "start": 64.423,
   "dur": 4.836458,
   "text": "Hayır Kenan. Bu defter kapanmadı. Benim adıma yazılan her kuruşun hesabını öğreneceğim."
  },
  {
   "id": "l19",
   "who": "defne",
   "scene": "night",
   "start": 70.459,
   "dur": 2.826708,
   "text": "Telefonuma bilinmeyen bir numaradan mesaj geldi."
  },
  {
   "id": "l20",
   "who": "defne",
   "scene": "night",
   "start": 73.786,
   "dur": 2.320167,
   "text": "Demek bu sırrı bilen başka biri daha var..."
  },
  {
   "id": "l21",
   "who": "defne",
   "scene": "diary",
   "start": 77.306,
   "dur": 4.098958,
   "text": "Mesajda yazıyor: Yarın saat 10.00'da eski banka şubesinin önünde ol."
  },
  {
   "id": "l22",
   "who": "defne",
   "scene": "diary",
   "start": 82.405,
   "dur": 1.774833,
   "text": "Bu buluşma tesadüf olamaz."
  }
 ]
}