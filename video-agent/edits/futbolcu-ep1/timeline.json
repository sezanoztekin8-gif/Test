 "lines": [
  {
   "id": "l01",
   "who": "anlatici",
   "img": "s01",
   "start": 0.8,
   "dur": 5.564082,
   "text": "Gün bir! Seçmelere otuz gün kaldı. Ve Emre... henüz koltuktan bile kalkmadı."
  },
  {
   "id": "l02",
   "who": "anlatici",
   "img": "s02",
   "start": 9.349,
   "dur": 4.91102,
   "text": "Dün gece bir ilan gördü: mahallenin takımı, otuz gün sonra yeni oyuncu seçecek."
  },
  {
   "id": "l02b",
   "who": "anlatici",
   "img": "s02",
   "start": 14.76,
   "dur": 3.84,
   "text": "Emre'nin futbol tecrübesi mi? Bilgisayarda üç kere şampiyon olmak."
  },
  {
   "id": "l03",
   "who": "emre",
   "img": "s02",
   "start": 19.1,
   "dur": 2.638367,
   "text": "Otuz gün mü? Yeter de artar bile!"
  },
  {
   "id": "l04",
   "who": "anlatici",
   "img": "s04",
   "start": 28.238,
   "dur": 4.022857,
   "text": "Sabah altı. Alarm çalıyor. Emre alarmı tam dört kez erteliyor."
  },
  {
   "id": "l05",
   "who": "dede",
   "img": "s05",
   "start": 35.245,
   "dur": 5.511837,
   "text": "Kalk bakalım şampiyon! Ben senin yaşındayken sabah koşusunu çoktan bitirmiştim!"
  },
  {
   "id": "l06",
   "who": "emre",
   "img": "s06",
   "start": 43.742,
   "dur": 3.422041,
   "text": "Dede... Forma mı küçülmüş, ben mi büyümüşüm?"
  },
  {
   "id": "l07",
   "who": "dede",
   "img": "s06",
   "start": 47.664,
   "dur": 2.76898,
   "text": "Sen büyümüşsün evladım. Ama yana doğru."
  },
  {
   "id": "l07b",
   "who": "emre",
   "img": "s06",
   "start": 50.933,
   "dur": 2.951837,
   "text": "Tamam, tamam! Bugün başlıyoruz. Yeni Emre geliyor!"
  },
  {
   "id": "l08",
   "who": "anlatici",
   "img": "s07",
   "start": 56.869,
   "dur": 3.578776,
   "text": "Ve ilk antrenman başlıyor. Hedef: mahalleyi bir tur koşmak."
  },
  {
   "id": "l09",
   "who": "anlatici",
   "img": "s08",
   "start": 63.432,
   "dur": 4.780408,
   "text": "İki yüzüncü metrede Emre'nin ciğerleri pes ediyor. Teyzeler bile onu geçiyor."
  },
  {
   "id": "l10",
   "who": "emre",
   "img": "s08",
   "start": 68.713,
   "dur": 2.45551,
   "text": "Dede... Ben galiba ölüyorum."
  },
  {
   "id": "l11",
   "who": "dede",
   "img": "s09",
   "start": 74.152,
   "dur": 3.892245,
   "text": "Daha fırına bile varmadık! Kanepe olmuşsun sen, kanepe!"
  },
  {
   "id": "l11b",
   "who": "dede",
   "img": "s09",
   "start": 78.545,
   "dur": 5.093878,
   "text": "Ben senin yaşında bu sokağı on tur koşardım. Hem de lastik ayakkabıyla!"
  },
  {
   "id": "l12",
   "who": "anlatici",
   "img": "s10",
   "start": 86.623,
   "dur": 2.35102,
   "text": "Sahada ise mahallenin yıldızı Burak var."
  },
  {
   "id": "l13",
   "who": "burak",
   "img": "s11",
   "start": 91.959,
   "dur": 5.877551,
   "text": "Emre? Sen mi seçmelere gireceksin? Önce merdivenleri çıkmayı dene, kanka."
  },
  {
   "id": "l13b",
   "who": "emre",
   "img": "s11",
   "start": 98.336,
   "dur": 2.45551,
   "text": "Bak sen... Otuz gün sonra görürüz."
  },
  {
   "id": "l14",
   "who": "anlatici",
   "img": "s12",
   "start": 103.776,
   "dur": 6.635102,
   "text": "Ama tribünde biri bu konuşmayı duydu. Elif. Mahallenin kitap kurdu, her sabah burada ders çalışıyor."
  },
  {
   "id": "l15",
   "who": "anlatici",
   "img": "s13",
   "start": 113.396,
   "dur": 2.951837,
   "text": "Emre ilk şutunu atıyor... ve topu ıskalıyor."
  },
  {
   "id": "l16",
   "who": "dede",
   "img": "s14",
   "start": 119.332,
   "dur": 4.127347,
   "text": "Futbolcular da düşer evlat. Önemli olan, kalkmak."
  },
  {
   "id": "l16b",
   "who": "emre",
   "img": "s14",
   "start": 123.959,
   "dur": 2.925714,
   "text": "Kalkıyorum dede. Ama bir dakika daha yatayım."
  },
  {
   "id": "l17",
   "who": "anlatici",
   "img": "s15",
   "start": 129.869,
   "dur": 3.474286,
   "text": "Akşam. Emre hayatında ilk kez cipsi çöpe atıyor."
  },
  {
   "id": "l18",
   "who": "emre",
   "img": "s15",
   "start": 133.844,
   "dur": 2.76898,
   "text": "Elveda dostum. Seni hiç unutmayacağım."
  },
  {
   "id": "l19",
   "who": "anlatici",
   "img": "s16",
   "start": 139.597,
   "dur": 4.440816,
   "text": "Bacakları ağrıyor. Ama defterine tek bir şey yazıyor: yirmi dokuz gün."
  },
  {
   "id": "l20",
   "who": "anlatici",
   "img": "s17",
   "start": 147.022,
   "dur": 3.604898,
   "text": "Tam uyuyacakken telefonuna bir mesaj geliyor... Elif yazmış."
  },
  {
   "id": "l20b",
   "who": "emre",
   "img": "s17",
   "start": 151.127,
   "dur": 5.093878,
   "text": "Yarın sahada mısın, diyor... Dede! Yarın sabah beşte kalkıyoruz!"
  },
  {
   "id": "l21",
   "who": "anlatici",
   "img": "cta",
   "start": 159.206,
   "dur": 8.594286,
   "text": "Peki Emre yarın ne yapsın? Sabah koşusu mu, yoksa sahada top mu? Karar senin! Yorumlara tek kelime yaz: KOŞU ya da TOP."
  }
 ]
}