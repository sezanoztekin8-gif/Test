{
 "title": "Bu Sefer Ezilmeyeceğim — 1. Bölüm",
 "voices": {
  "defne": "default",
  "kenan": "ref_kenan",
  "nermin": "ref_nermin",
  "ali": "ref_ali"
 },
 "lines": [
  {
   "id": "l01",
   "scene": "bedroom",
   "who": "nermin",
   "inner": false,
   "ex": 0.5,
   "text": "Zehra! Hâlâ yatakta mısın? Kahvaltı ne olacak?"
  },
  {
   "id": "l02",
   "scene": "bedroom",
   "who": "defne",
   "inner": true,
   "ex": 0.5,
   "text": "Bu sabah ilk iş bu defterdeki hesabı çözeceğim."
  },
  {
   "id": "l03",
   "scene": "mirror",
   "who": "defne",
   "inner": true,
   "ex": 0.5,
   "text": "Defterin arkasında bir banka numarası var. Zehra'nın adına."
  },
  {
   "id": "l04",
   "scene": "mirror",
   "who": "defne",
   "inner": true,
   "ex": 0.5,
   "text": "Bu evin parasını kimse benden sormadan harcayamaz."
  },
  {
   "id": "l05",
   "scene": "door",
   "who": "ali",
   "inner": false,
   "ex": 0.5,
   "text": "Anne, bugün okulda para için bir proje var. Yardım eder misin?"
  },
  {
   "id": "l06",
   "scene": "door",
   "who": "defne",
   "inner": true,
   "ex": 0.5,
   "text": "Bu çocuk bile bu evde bir şeyi sormaya korkuyor."
  },
  {
   "id": "l07",
   "scene": "door",
   "who": "defne",
   "inner": false,
   "ex": 0.5,
   "text": "Sor bakalım bir tanem. Annen cevap verecek."
  },
  {
   "id": "l08",
   "scene": "table",
   "who": "nermin",
   "inner": false,
   "ex": 0.5,
   "text": "Ne bu şimdi, bir de hesap mı soracaksın?"
  },
  {
   "id": "l09",
   "scene": "table",
   "who": "kenan",
   "inner": false,
   "ex": 0.5,
   "text": "Para meselesi bana ait. Sen mutfakta kal."
  },
  {
   "id": "l10",
   "scene": "table",
   "who": "defne",
   "inner": true,
   "ex": 0.5,
   "text": "Kenan maaşını hiç söylemedi. Zehra bunu da biliyordu."
  },
  {
   "id": "l11",
   "scene": "table",
   "who": "kenan",
   "inner": false,
   "ex": 0.5,
   "text": "Sana bir şey dedim! Anlamıyor musun?"
  },
  {
   "id": "l12",
   "scene": "table",
   "who": "ali",
   "inner": false,
   "ex": 0.5,
   "text": "Anne..."
  },
  {
   "id": "l13",
   "scene": "turn",
   "who": "defne",
   "inner": false,
   "ex": 0.5,
   "text": "Kenan. Bu evin hesabını bugün açıkça konuşacağız. Ben de soracağım."
  },
  {
   "id": "l14",
   "scene": "turn",
   "who": "nermin",
   "inner": false,
   "ex": 0.5,
   "text": "Sen... bu nasıl cüret..."
  },
  {
   "id": "l15",
   "scene": "turn",
   "who": "defne",
   "inner": false,
   "ex": 0.5,
   "text": "Nermin Hanım, sizin de bilmek istediğiniz şeyler var, değil mi?"
  },
  {
   "id": "l16",
   "scene": "turn",
   "who": "defne",
   "inner": true,
   "ex": 0.5,
   "text": "Masa sustu. Sessizliğin bu kadar ağır olduğunu hiç bilmiyordum."
  },
  {
   "id": "l17",
   "scene": "turn",
   "who": "kenan",
   "inner": false,
   "ex": 0.5,
   "text": "Akşam konuşacağız."
  },
  {
   "id": "l18",
   "scene": "turn",
   "who": "defne",
   "inner": false,
   "ex": 0.5,
   "text": "Akşam değil, şimdi. Telefonunu da masaya koy."
  },
  {
   "id": "l19",
   "scene": "night",
   "who": "ali",
   "inner": false,
   "ex": 0.5,
   "text": "Anne, bugün babamla çok konuştun. Korkmadın mı?"
  },
  {
   "id": "l20",
   "scene": "night",
   "who": "defne",
   "inner": false,
   "ex": 0.5,
   "text": "Korktum. Ama artık korkuyu kendi hesabıma yazıyorum."
  },
  {
   "id": "l21",
   "scene": "diary",
   "who": "defne",
   "inner": true,
   "ex": 0.5,
   "text": "Defterin son sayfasında bir hesap dökümü var. Maaşın tamamı, her ay."
  },
  {
   "id": "l22",
   "scene": "diary",
   "who": "defne",
   "inner": true,
   "ex": 0.5,
   "text": "Rakamlar yalan söylemiyor. Ama bir kalem eksik. Onu bulacağım."
  }
 ]
}