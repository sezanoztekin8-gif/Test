 "lines": [
  {
   "id": "l01",
   "who": "nermin",
   "scene": "bedroom",
   "start": 0.35,
   "dur": 2.479333,
   "text": "Zehra! Hâlâ yatakta mısın? Kahvaltı ne olacak?"
  },
  {
   "id": "l02",
   "who": "defne",
   "scene": "bedroom",
   "start": 3.109,
   "dur": 2.558875,
   "text": "Bu sabah ilk iş bu defterdeki hesabı çözeceğim."
  },
  {
   "id": "l03",
   "who": "defne",
   "scene": "mirror",
   "start": 6.468,
   "dur": 3.411625,
   "text": "Defterin arkasında bir banka numarası var. Zehra'nın adına."
  },
  {
   "id": "l04",
   "who": "defne",
   "scene": "mirror",
   "start": 10.16,
   "dur": 2.962542,
   "text": "Bu evin parasını kimse benden sormadan harcayamaz."
  },
  {
   "id": "l05",
   "who": "ali",
   "scene": "door",
   "start": 16.522,
   "dur": 3.471625,
   "text": "Anne, bugün okulda para için bir proje var. Yardım eder misin?"
  },
  {
   "id": "l06",
   "who": "defne",
   "scene": "door",
   "start": 20.274,
   "dur": 2.758875,
   "text": "Bu çocuk bile bu evde bir şeyi sormaya korkuyor."
  },
  {
   "id": "l07",
   "who": "defne",
   "scene": "door",
   "start": 23.313,
   "dur": 2.423417,
   "text": "Sor bakalım bir tanem. Annen cevap verecek."
  },
  {
   "id": "l08",
   "who": "nermin",
   "scene": "table",
   "start": 26.536,
   "dur": 1.953042,
   "text": "Ne bu şimdi, bir de hesap mı soracaksın?"
  },
  {
   "id": "l09",
   "who": "kenan",
   "scene": "table",
   "start": 28.769,
   "dur": 2.151958,
   "text": "Para meselesi bana ait. Sen mutfakta kal."
  },
  {
   "id": "l10",
   "who": "defne",
   "scene": "table",
   "start": 31.201,
   "dur": 2.962,
   "text": "Kenan maaşını hiç söylemedi. Zehra bunu da biliyordu."
  },
  {
   "id": "l11",
   "who": "kenan",
   "scene": "table",
   "start": 34.443,
   "dur": 1.834375,
   "text": "Sana bir şey dedim! Anlamıyor musun?"
  },
  {
   "id": "l12",
   "who": "ali",
   "scene": "table",
   "start": 36.558,
   "dur": 0.505958,
   "text": "Anne..."
  },
  {
   "id": "l13",
   "who": "defne",
   "scene": "turn",
   "start": 37.894,
   "dur": 3.680042,
   "text": "Kenan. Bu evin hesabını bugün açıkça konuşacağız. Ben de soracağım."
  },
  {
   "id": "l14",
   "who": "nermin",
   "scene": "turn",
   "start": 41.854,
   "dur": 1.530625,
   "text": "Sen... bu nasıl cüret..."
  },
  {
   "id": "l15",
   "who": "defne",
   "scene": "turn",
   "start": 43.664,
   "dur": 3.565667,
   "text": "Nermin Hanım, sizin de bilmek istediğiniz şeyler var, değil mi?"
  },
  {
   "id": "l16",
   "who": "defne",
   "scene": "turn",
   "start": 47.51,
   "dur": 3.593292,
   "text": "Masa sustu. Sessizliğin bu kadar ağır olduğunu hiç bilmiyordum."
  },
  {
   "id": "l17",
   "who": "kenan",
   "scene": "turn",
   "start": 51.383,
   "dur": 1.10525,
   "text": "Akşam konuşacağız."
  },
  {
   "id": "l18",
   "who": "defne",
   "scene": "turn",
   "start": 53.319,
   "dur": 2.520708,
   "text": "Akşam değil, şimdi. Telefonunu da masaya koy."
  },
  {
   "id": "l19",
   "who": "ali",
   "scene": "night",
   "start": 56.639,
   "dur": 2.557708,
   "text": "Anne, bugün babamla çok konuştun. Korkmadın mı?"
  },
  {
   "id": "l20",
   "who": "defne",
   "scene": "night",
   "start": 59.477,
   "dur": 2.886667,
   "text": "Korktum. Ama artık korkuyu kendi hesabıma yazıyorum."
  },
  {
   "id": "l21",
   "who": "defne",
   "scene": "diary",
   "start": 63.164,
   "dur": 4.426875,
   "text": "Defterin son sayfasında bir rakam var. Kenan'ın hesabındaki paranın yarısı."
  },
  {
   "id": "l22",
   "who": "defne",
   "scene": "diary",
   "start": 68.37,
   "dur": 3.742625,
   "text": "Eksik kalem bir kredi kartı. Bu evde kimsenin bilmediği bir kart."
  }
 ]
}