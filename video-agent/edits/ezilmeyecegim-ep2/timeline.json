 "lines": [
  {
   "id": "l01",
   "who": "nermin",
   "scene": "bedroom",
   "start": 0.35,
   "dur": 2.35325,
   "text": "Zehra! Hâlâ yatakta mısın? Kahvaltı ne olacak?"
  },
  {
   "id": "l02",
   "who": "defne",
   "scene": "bedroom",
   "start": 2.983,
   "dur": 2.682208,
   "text": "Bu sabah ilk iş bu defterdeki hesabı çözeceğim."
  },
  {
   "id": "l03",
   "who": "defne",
   "scene": "mirror",
   "start": 6.465,
   "dur": 3.480583,
   "text": "Defterin arkasında bir banka numarası var. Zehra'nın adına."
  },
  {
   "id": "l04",
   "who": "defne",
   "scene": "mirror",
   "start": 10.226,
   "dur": 3.00825,
   "text": "Bu evin parasını kimse benden sormadan harcayamaz."
  },
  {
   "id": "l05",
   "who": "ali",
   "scene": "door",
   "start": 16.634,
   "dur": 3.384792,
   "text": "Anne, bugün okulda para için bir proje var. Yardım eder misin?"
  },
  {
   "id": "l06",
   "who": "defne",
   "scene": "door",
   "start": 20.299,
   "dur": 2.705875,
   "text": "Bu çocuk bile bu evde bir şeyi sormaya korkuyor."
  },
  {
   "id": "l07",
   "who": "defne",
   "scene": "door",
   "start": 23.285,
   "dur": 2.405833,
   "text": "Sor bakalım bir tanem. Annen cevap verecek."
  },
  {
   "id": "l08",
   "who": "nermin",
   "scene": "table",
   "start": 26.491,
   "dur": 1.856708,
   "text": "Ne bu şimdi, bir de hesap mı soracaksın?"
  },
  {
   "id": "l09",
   "who": "kenan",
   "scene": "table",
   "start": 28.627,
   "dur": 2.013417,
   "text": "Para meselesi bana ait. Sen mutfakta kal."
  },
  {
   "id": "l10",
   "who": "defne",
   "scene": "table",
   "start": 30.921,
   "dur": 2.964708,
   "text": "Kenan maaşını hiç söylemedi. Zehra bunu da biliyordu."
  },
  {
   "id": "l11",
   "who": "kenan",
   "scene": "table",
   "start": 34.166,
   "dur": 1.822125,
   "text": "Sana bir şey dedim! Anlamıyor musun?"
  },
  {
   "id": "l12",
   "who": "ali",
   "scene": "table",
   "start": 36.268,
   "dur": 0.576875,
   "text": "Anne..."
  },
  {
   "id": "l13",
   "who": "defne",
   "scene": "turn",
   "start": 37.675,
   "dur": 3.658708,
   "text": "Kenan. Bu evin hesabını bugün açıkça konuşacağız. Ben de soracağım."
  },
  {
   "id": "l14",
   "who": "nermin",
   "scene": "turn",
   "start": 41.613,
   "dur": 1.178333,
   "text": "Sen... bu nasıl cüret..."
  },
  {
   "id": "l15",
   "who": "defne",
   "scene": "turn",
   "start": 43.072,
   "dur": 3.411083,
   "text": "Nermin Hanım, sizin de bilmek istediğiniz şeyler var, değil mi?"
  },
  {
   "id": "l16",
   "who": "defne",
   "scene": "turn",
   "start": 46.763,
   "dur": 3.70325,
   "text": "Masa sustu. Sessizliğin bu kadar ağır olduğunu hiç bilmiyordum."
  },
  {
   "id": "l17",
   "who": "kenan",
   "scene": "turn",
   "start": 50.746,
   "dur": 1.1065,
   "text": "Akşam konuşacağız."
  },
  {
   "id": "l18",
   "who": "defne",
   "scene": "turn",
   "start": 52.682,
   "dur": 2.550292,
   "text": "Akşam değil, şimdi. Telefonunu da masaya koy."
  },
  {
   "id": "l19",
   "who": "ali",
   "scene": "night",
   "start": 56.033,
   "dur": 2.604167,
   "text": "Anne, bugün babamla çok konuştun. Korkmadın mı?"
  },
  {
   "id": "l20",
   "who": "defne",
   "scene": "night",
   "start": 58.917,
   "dur": 3.01075,
   "text": "Korktum. Ama artık korkuyu kendi hesabıma yazıyorum."
  },
  {
   "id": "l21",
   "who": "defne",
   "scene": "diary",
   "start": 62.728,
   "dur": 3.937917,
   "text": "Defterin son sayfasında bir hesap dökümü var. Maaşın tamamı, her ay."
  },
  {
   "id": "l22",
   "who": "defne",
   "scene": "diary",
   "start": 67.446,
   "dur": 3.539875,
   "text": "Rakamlar yalan söylemiyor. Ama bir kalem eksik. Onu bulacağım."
  }
 ]
}