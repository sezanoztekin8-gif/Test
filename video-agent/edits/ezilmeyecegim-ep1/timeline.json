 "lines": [
  {
   "id": "l01",
   "who": "nermin",
   "scene": "bedroom",
   "start": 0.35,
   "dur": 2.896708,
   "text": "Zehra! Saat yedi oldu, kahvaltı hâlâ hazır değil mi?!"
  },
  {
   "id": "l02",
   "who": "defne",
   "scene": "bedroom",
   "start": 3.527,
   "dur": 2.234708,
   "text": "Zehra mı? Benim adım Defne. Burası neresi?"
  },
  {
   "id": "l03",
   "who": "defne",
   "scene": "mirror",
   "start": 6.561,
   "dur": 3.70925,
   "text": "Bu yüz... benim değil. Dün geceki kazayı hatırlıyorum. Sonra karanlık."
  },
  {
   "id": "l04",
   "who": "defne",
   "scene": "mirror",
   "start": 10.551,
   "dur": 1.921917,
   "text": "Başka bir kadının hayatında uyandım."
  },
  {
   "id": "l05",
   "who": "ali",
   "scene": "door",
   "start": 15.873,
   "dur": 1.903625,
   "text": "Anne... çabuk ol. Babam yine kızacak."
  },
  {
   "id": "l06",
   "who": "defne",
   "scene": "door",
   "start": 18.056,
   "dur": 2.902042,
   "text": "Bu çocuk benden korkmuyor. Ama bir şeyden çok korkuyor."
  },
  {
   "id": "l07",
   "who": "defne",
   "scene": "door",
   "start": 21.238,
   "dur": 1.733833,
   "text": "Korkma bir tanem. Annen burada."
  },
  {
   "id": "l08",
   "who": "nermin",
   "scene": "table",
   "start": 23.772,
   "dur": 3.442333,
   "text": "Hanımefendi nihayet teşrif etti! Çay soğudu, ekmek bayatladı!"
  },
  {
   "id": "l09",
   "who": "kenan",
   "scene": "table",
   "start": 27.494,
   "dur": 2.751208,
   "text": "Bütün gün evdesin. Bir kahvaltıyı bile beceremiyorsun."
  },
  {
   "id": "l10",
   "who": "defne",
   "scene": "table",
   "start": 30.526,
   "dur": 3.176708,
   "text": "Demek Zehra her sabah bunu dinliyordu. Başını eğip, susarak."
  },
  {
   "id": "l11",
   "who": "kenan",
   "scene": "table",
   "start": 33.982,
   "dur": 1.621375,
   "text": "Sana konuşuyorum! Cevap versene!"
  },
  {
   "id": "l12",
   "who": "ali",
   "scene": "table",
   "start": 35.884,
   "dur": 0.553292,
   "text": "Anne..."
  },
  {
   "id": "l13",
   "who": "defne",
   "scene": "turn",
   "start": 37.267,
   "dur": 3.799125,
   "text": "Kenan. Bir daha bu evde kimse sesini yükseltmeyecek. Ne ben, ne de oğlum."
  },
  {
   "id": "l14",
   "who": "nermin",
   "scene": "turn",
   "start": 41.346,
   "dur": 1.454792,
   "text": "Sen... Sen ne cüretle..."
  },
  {
   "id": "l15",
   "who": "defne",
   "scene": "turn",
   "start": 43.081,
   "dur": 1.706708,
   "text": "Nermin Hanım, çayınız soğumasın."
  },
  {
   "id": "l16",
   "who": "defne",
   "scene": "turn",
   "start": 45.068,
   "dur": 3.579333,
   "text": "Herkes donup kaldı. Zehra'nın sesini bu evde ilk kez duyuyorlardı."
  },
  {
   "id": "l17",
   "who": "kenan",
   "scene": "turn",
   "start": 48.927,
   "dur": 1.107,
   "text": "Akşam konuşacağız."
  },
  {
   "id": "l18",
   "who": "defne",
   "scene": "turn",
   "start": 50.864,
   "dur": 2.237792,
   "text": "Konuşuruz. Ama bu sefer ben de konuşacağım."
  },
  {
   "id": "l19",
   "who": "ali",
   "scene": "night",
   "start": 53.902,
   "dur": 2.767333,
   "text": "Anne, bugün çok cesurdun. Hep böyle mi kalacaksın?"
  },
  {
   "id": "l20",
   "who": "defne",
   "scene": "night",
   "start": 56.949,
   "dur": 1.841,
   "text": "Bundan sonra kimse bize bağıramayacak."
  },
  {
   "id": "l21",
   "who": "defne",
   "scene": "diary",
   "start": 59.59,
   "dur": 3.559458,
   "text": "Gece yarısı, yatağın altında bir defter buldum. Zehra'nın el yazısı."
  },
  {
   "id": "l22",
   "who": "defne",
   "scene": "diary",
   "start": 63.93,
   "dur": 4.930625,
   "text": "Son sayfada tek bir cümle vardı. Yarın her şeyi anlatacağım... Bana bir şey olursa, bu defteri okuyun."
  }
 ]
}