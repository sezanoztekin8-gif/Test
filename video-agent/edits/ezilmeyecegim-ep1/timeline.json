 "lines": [
  {
   "id": "l01",
   "who": "nermin",
   "scene": "bedroom",
   "start": 0.35,
   "dur": 2.528125,
   "text": "Zehra! Saat yedi oldu, kahvaltı hâlâ hazır değil mi?!"
  },
  {
   "id": "l02",
   "who": "defne",
   "scene": "bedroom",
   "start": 3.158,
   "dur": 2.261917,
   "text": "Zehra mı? Benim adım Defne. Burası neresi?"
  },
  {
   "id": "l03",
   "who": "defne",
   "scene": "mirror",
   "start": 6.22,
   "dur": 3.609,
   "text": "Bu yüz... benim değil. Dün geceki kazayı hatırlıyorum. Sonra karanlık."
  },
  {
   "id": "l04",
   "who": "defne",
   "scene": "mirror",
   "start": 10.109,
   "dur": 2.031625,
   "text": "Başka bir kadının hayatında uyandım."
  },
  {
   "id": "l05",
   "who": "ali",
   "scene": "door",
   "start": 15.541,
   "dur": 1.903625,
   "text": "Anne... çabuk ol. Babam yine kızacak."
  },
  {
   "id": "l06",
   "who": "defne",
   "scene": "door",
   "start": 17.724,
   "dur": 3.111167,
   "text": "Bu çocuk benden korkmuyor. Ama bir şeyden çok korkuyor."
  },
  {
   "id": "l07",
   "who": "defne",
   "scene": "door",
   "start": 21.115,
   "dur": 1.759583,
   "text": "Korkma bir tanem. Annen burada."
  },
  {
   "id": "l08",
   "who": "nermin",
   "scene": "table",
   "start": 23.675,
   "dur": 2.974833,
   "text": "Hanımefendi nihayet teşrif etti! Çay soğudu, ekmek bayatladı!"
  },
  {
   "id": "l09",
   "who": "kenan",
   "scene": "table",
   "start": 26.93,
   "dur": 2.751208,
   "text": "Bütün gün evdesin. Bir kahvaltıyı bile beceremiyorsun."
  },
  {
   "id": "l10",
   "who": "defne",
   "scene": "table",
   "start": 29.961,
   "dur": 3.28125,
   "text": "Demek Zehra her sabah bunu dinliyordu. Başını eğip, susarak."
  },
  {
   "id": "l11",
   "who": "kenan",
   "scene": "table",
   "start": 33.522,
   "dur": 1.621375,
   "text": "Sana konuşuyorum! Cevap versene!"
  },
  {
   "id": "l12",
   "who": "ali",
   "scene": "table",
   "start": 35.424,
   "dur": 0.553292,
   "text": "Anne..."
  },
  {
   "id": "l13",
   "who": "defne",
   "scene": "turn",
   "start": 36.807,
   "dur": 3.833792,
   "text": "Kenan. Bir daha bu evde kimse sesini yükseltmeyecek. Ne ben, ne de oğlum."
  },
  {
   "id": "l14",
   "who": "nermin",
   "scene": "turn",
   "start": 40.921,
   "dur": 1.431417,
   "text": "Sen... Sen ne cüretle..."
  },
  {
   "id": "l15",
   "who": "defne",
   "scene": "turn",
   "start": 42.632,
   "dur": 1.655917,
   "text": "Nermin Hanım, çayınız soğumasın."
  },
  {
   "id": "l16",
   "who": "defne",
   "scene": "turn",
   "start": 44.568,
   "dur": 3.780917,
   "text": "Herkes donup kaldı. Zehra'nın sesini bu evde ilk kez duyuyorlardı."
  },
  {
   "id": "l17",
   "who": "kenan",
   "scene": "turn",
   "start": 48.629,
   "dur": 1.107,
   "text": "Akşam konuşacağız."
  },
  {
   "id": "l18",
   "who": "defne",
   "scene": "turn",
   "start": 50.566,
   "dur": 2.377125,
   "text": "Konuşuruz. Ama bu sefer ben de konuşacağım."
  },
  {
   "id": "l19",
   "who": "ali",
   "scene": "night",
   "start": 53.743,
   "dur": 2.767333,
   "text": "Anne, bugün çok cesurdun. Hep böyle mi kalacaksın?"
  },
  {
   "id": "l20",
   "who": "defne",
   "scene": "night",
   "start": 56.791,
   "dur": 2.054125,
   "text": "Bundan sonra kimse bize bağıramayacak."
  },
  {
   "id": "l21",
   "who": "defne",
   "scene": "diary",
   "start": 59.645,
   "dur": 3.877667,
   "text": "Gece yarısı, yatağın altında bir defter buldum. Zehra'nın el yazısı."
  },
  {
   "id": "l22",
   "who": "defne",
   "scene": "diary",
   "start": 64.302,
   "dur": 5.66225,
   "text": "Son sayfada tek bir cümle vardı. Yarın her şeyi anlatacağım... Bana bir şey olursa, bu defteri okuyun."
  }
 ]
}