 "lines": [
  {
   "id": "l01",
   "who": "nermin",
   "scene": "bedroom",
   "start": 0.35,
   "dur": 4.68625,
   "text": "Zehra! Saat yedi oldu, kahvaltı hâlâ hazır değil mi?!"
  },
  {
   "id": "l02",
   "who": "defne",
   "scene": "bedroom",
   "start": 5.316,
   "dur": 2.763667,
   "text": "Zehra mı? Benim adım Defne. Burası neresi?"
  },
  {
   "id": "l03",
   "who": "defne",
   "scene": "mirror",
   "start": 8.88,
   "dur": 3.907958,
   "text": "Bu yüz... benim değil. Dün geceki kazayı hatırlıyorum. Sonra karanlık."
  },
  {
   "id": "l04",
   "who": "defne",
   "scene": "mirror",
   "start": 13.068,
   "dur": 3.579667,
   "text": "Başka bir kadının hayatında uyandım."
  },
  {
   "id": "l05",
   "who": "ali",
   "scene": "door",
   "start": 20.048,
   "dur": 2.137875,
   "text": "Anne... çabuk ol. Babam yine kızacak."
  },
  {
   "id": "l06",
   "who": "defne",
   "scene": "door",
   "start": 22.465,
   "dur": 2.853458,
   "text": "Bu çocuk benden korkmuyor. Ama bir şeyden çok korkuyor."
  },
  {
   "id": "l07",
   "who": "defne",
   "scene": "door",
   "start": 25.599,
   "dur": 4.272917,
   "text": "Korkma bir tanem. Annen burada."
  },
  {
   "id": "l08",
   "who": "nermin",
   "scene": "table",
   "start": 30.672,
   "dur": 5.208333,
   "text": "Hanımefendi nihayet teşrif etti! Çay soğudu, ekmek bayatladı!"
  },
  {
   "id": "l09",
   "who": "kenan",
   "scene": "table",
   "start": 36.16,
   "dur": 2.802125,
   "text": "Bütün gün evdesin. Bir kahvaltıyı bile beceremiyorsun."
  },
  {
   "id": "l10",
   "who": "defne",
   "scene": "table",
   "start": 39.242,
   "dur": 4.145792,
   "text": "Demek Zehra her sabah bunu dinliyordu. Başını eğip, susarak."
  },
  {
   "id": "l11",
   "who": "kenan",
   "scene": "table",
   "start": 43.668,
   "dur": 2.379292,
   "text": "Sana konuşuyorum! Cevap versene!"
  },
  {
   "id": "l12",
   "who": "ali",
   "scene": "table",
   "start": 46.327,
   "dur": 0.504833,
   "text": "Anne..."
  },
  {
   "id": "l13",
   "who": "defne",
   "scene": "turn",
   "start": 47.662,
   "dur": 5.105917,
   "text": "Kenan. Bir daha bu evde kimse sesini yükseltmeyecek. Ne ben, ne de oğlum."
  },
  {
   "id": "l14",
   "who": "nermin",
   "scene": "turn",
   "start": 53.048,
   "dur": 1.887542,
   "text": "Sen... Sen ne cüretle..."
  },
  {
   "id": "l15",
   "who": "defne",
   "scene": "turn",
   "start": 55.216,
   "dur": 1.562708,
   "text": "Nermin Hanım, çayınız soğumasın."
  },
  {
   "id": "l16",
   "who": "defne",
   "scene": "turn",
   "start": 57.058,
   "dur": 5.016708,
   "text": "Herkes donup kaldı. Zehra'nın sesini bu evde ilk kez duyuyorlardı."
  },
  {
   "id": "l17",
   "who": "kenan",
   "scene": "turn",
   "start": 62.355,
   "dur": 1.216125,
   "text": "Akşam konuşacağız."
  },
  {
   "id": "l18",
   "who": "defne",
   "scene": "turn",
   "start": 64.401,
   "dur": 2.026708,
   "text": "Konuşuruz. Ama bu sefer ben de konuşacağım."
  },
  {
   "id": "l19",
   "who": "ali",
   "scene": "night",
   "start": 67.228,
   "dur": 4.147292,
   "text": "Anne, bugün çok cesurdun. Hep böyle mi kalacaksın?"
  },
  {
   "id": "l20",
   "who": "defne",
   "scene": "night",
   "start": 71.655,
   "dur": 2.710583,
   "text": "Söz veriyorum. Artık kimse bize bağıramayacak."
  },
  {
   "id": "l21",
   "who": "defne",
   "scene": "diary",
   "start": 75.166,
   "dur": 4.159583,
   "text": "Gece yarısı, yatağın altında bir defter buldum. Zehra'nın el yazısı."
  },
  {
   "id": "l22",
   "who": "defne",
   "scene": "diary",
   "start": 80.105,
   "dur": 5.511125,
   "text": "Son sayfada tek bir cümle vardı. Yarın her şeyi anlatacağım... Eğer bana bir şey olmazsa."
  }
 ]
}